# Leave empty to run in demo mode (all data stored in the browser).
# Fill both to switch the whole app to Supabase (run supabase/migrations/0001_init.sql first).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── الوضع الموحّد (AzmSmart) — يعلو الوضعين أعلاه حين يُضبط ──────────
# الباكند الموحّد: المتاجر والطلبات والفوترة فيه، ويديرها التاجر من AzmSmart.
# أصل هذه الواجهة يجب أن يكون في CORS_ORIGINS هناك.
NEXT_PUBLIC_UNIFIED_API_URL=
# تطبيق AzmSmart — الدخول وإدارة المتجر
NEXT_PUBLIC_AZMSMART_URL=

# النطاقات التي تخدم موقع المنصة نفسه (لا تُحلّ نطاقًا خاصًّا لمتجر)
# NEXT_PUBLIC_PLATFORM_HOSTS=localhost,127.0.0.1,rvios.store,www.rvios.store,store.rvios.com

# Google Analytics for the platform pages (default G-M457B7LQ9S) — empty turns it off
# NEXT_PUBLIC_GA_IDS=G-M457B7LQ9S
